# Julia compilation caches
*.ji
*.cov
*.jld2
# Resolved environments are not tracked: Project.toml and [compat] define the
# environment, and every run stores the manifest it was resolved on.
Manifest.toml
Manifest-v*.toml

# Run data and generated inputs. `/data/*` with the two negations keeps only
# data/runs/.gitkeep: git never descends into a directory excluded as a whole,
# so the directory itself is re-included and its contents excluded.
/data/*
!/data/runs/
/data/runs/*
!/data/runs/.gitkeep
# A root plots/ directory (DrWatson layout) and coverage outputs
/plots/
lcov.info
*.mem

# Documenter.jl artifacts
docs/build/
docs/site/

# VS Code / OS config
.vscode/
.idea/
.DS_Store
.AppleDouble
.LSOverride
